{
  "name": "@llblab/pi-state-flow",
  "version": "0.15.0",
  "private": false,
  "description": "Incremental scoped state/context/memory compiler for Pi, inspired by SKILL.state",
  "keywords": [
    "pi-package",
    "pi-extension",
    "state-management"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/llblab/pi-state-flow.git"
  },
  "homepage": "https://github.com/llblab/pi-state-flow",
  "bugs": {
    "url": "https://github.com/llblab/pi-state-flow/issues"
  },
  "type": "module",
  "files": [
    "index.ts",
    "lib",
    "dist",
    "skills",
    "docs",
    "README.md",
    "CHANGELOG.md",
    "BACKLOG.md",
    "AGENTS.md"
  ],
  "scripts": {
    "check": "node -e \"await import('./dist/pi-state-flow/index.js'); console.log('pi-state-flow: extension import ok')\"",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "benchmark": "node --experimental-strip-types benchmarks/benchmark.ts",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build-dist.mjs",
    "pack:check": "npm pack --dry-run",
    "validate": "npm run build && npm run typecheck && npm test && npm run check && npm run pack:check",
    "prepack": "npm run build"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "pi": {
    "extensions": [
      "./dist/pi-state-flow/index.js"
    ],
    "sourceExtensions": [
      "./index.ts"
    ],
    "skills": [
      "./dist/skills"
    ],
    "sourceSkills": [
      "./skills"
    ],
    "image": "https://raw.githubusercontent.com/llblab/pi-state-flow/main/banner.jpg"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "^0.84.4 || ^0.85.1",
    "@earendil-works/pi-ai": "^0.84.4 || ^0.85.1",
    "@earendil-works/pi-coding-agent": "^0.84.4 || ^0.85.1",
    "@earendil-works/pi-tui": "^0.84.4 || ^0.85.1"
  },
  "devDependencies": {
    "@earendil-works/pi-tui": "0.84.4",
    "@types/node": "latest",
    "typescript": "latest"
  }
}
